      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{base_url}}/alerts/check",
          "host": ["{{base_url}}"],
          "path": ["alerts", "check"]
        }
      },
      "response": []
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:9090",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ]
}
