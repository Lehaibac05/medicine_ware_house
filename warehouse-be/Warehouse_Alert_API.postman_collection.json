            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"comment\": \"Restocked from supplier, issue resolved\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/alerts/1/resolve",
          "host": ["{{base_url}}"],
          "path": ["alerts", "1", "resolve"]
        }
      },
      "response": []
    },
    {
