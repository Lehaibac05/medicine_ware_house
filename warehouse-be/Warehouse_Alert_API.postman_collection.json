          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"comment\": \"\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/alerts/2/resolve",
          "host": ["{{base_url}}"],
          "path": ["alerts", "2", "resolve"]
        }
      },
      "response": []
    },
    {
