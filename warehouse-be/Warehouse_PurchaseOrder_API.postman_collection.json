          "request": {
            "method": "POST",
            "header": [],
            "url": { "raw": "{{baseUrl}}/purchase-orders/{{purchaseOrderId}}/confirm", "host": ["{{baseUrl}}"], "path": ["purchase-orders", "{{purchaseOrderId}}", "confirm"] }
          }
        },
        {
          "name": "Cập nhật: Đang chuẩn bị hàng (PREPARING)",
          "event": [
            {
              "listen": "test",
