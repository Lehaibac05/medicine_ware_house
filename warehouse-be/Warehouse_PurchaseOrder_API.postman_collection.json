          }
        },
        {
          "name": "Cập nhật: Đang giao hàng (SHIPPING)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Status chuyển sang SHIPPING', function() { pm.expect(data.status).to.eql('SHIPPING'); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SHIPPING\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/purchase-orders/{{purchaseOrderId}}/status", "host": ["{{baseUrl}}"], "path": ["purchase-orders", "{{purchaseOrderId}}", "status"] }
          }
        }
      ]
    },
    {
      "name": "5. BƯỚC 3 - Nhân viên kho tiếp nhận thuốc",
      "item": [
        {
          "name": "Tạo Goods Receipt (kiểm tra & nhập dữ liệu)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.collectionVariables.set('goodsReceiptId', data.receiptId);",
                  "console.log('Goods Receipt ID:', data.receiptId, 'Code:', data.receiptCode);",
                  "pm.test('Có receiptCode', function() { pm.expect(data.receiptCode).to.include('GR-'); });",
                  "pm.test('Status là PENDING_APPROVAL', function() { pm.expect(data.status).to.eql('PENDING_APPROVAL'); });",
                  "pm.test('qualityPassed = true', function() { pm.expect(data.qualityPassed).to.be.true; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"purchaseOrderId\": {{purchaseOrderId}},\n  \"qualityPassed\": true,\n  \"qualityCheckNotes\": \"Hàng đúng số lượng. Bao bì nguyên vẹn, không bị rách hoặc hư hỏng. Hạn sử dụng còn trên 2 năm. Đủ điều kiện nhập kho.\",\n  \"receivedItems\": [\n    {\n      \"itemId\": {{purchaseOrderItemId1}},\n      \"receivedQuantity\": 200,\n      \"actualExpiryDate\": \"2028-06-01\",\n      \"lotNumber\": \"LOT-ABC-2026-001\",\n      \"manufactureDate\": \"2026-01-15\"\n    },\n    {\n      \"itemId\": {{purchaseOrderItemId2}},\n      \"receivedQuantity\": 98,\n      \"actualExpiryDate\": \"2028-01-01\",\n      \"lotNumber\": \"LOT-ABC-2026-002\",\n      \"manufactureDate\": \"2026-01-20\"\n    }\n  ]\n}"
            },
            "url": { "raw": "{{baseUrl}}/goods-receipts", "host": ["{{baseUrl}}"], "path": ["goods-receipts"] }
          }
        },
        {
          "name": "Xem chi tiết Goods Receipt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Status vẫn PENDING_APPROVAL', function() { pm.expect(data.status).to.eql('PENDING_APPROVAL'); });",
                  "pm.test('Có purchaseOrder info', function() { pm.expect(data.purchaseOrder).to.not.be.null; });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/goods-receipts/{{goodsReceiptId}}", "host": ["{{baseUrl}}"], "path": ["goods-receipts", "{{goodsReceiptId}}"] }
          }
        },
        {
          "name": "Xem danh sách Goods Receipt chờ duyệt",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Có ít nhất 1 receipt chờ duyệt', function() { pm.expect(data.length).to.be.at.least(1); });"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/goods-receipts/pending", "host": ["{{baseUrl}}"], "path": ["goods-receipts", "pending"] }
          }
        },
        {
          "name": "Tìm Goods Receipt theo Purchase Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Đúng purchase order', function() {",
                  "    pm.expect(String(data.purchaseOrder.purchaseOrderId)).to.eql(pm.collectionVariables.get('purchaseOrderId'));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/goods-receipts/purchase-order/{{purchaseOrderId}}", "host": ["{{baseUrl}}"], "path": ["goods-receipts", "purchase-order", "{{purchaseOrderId}}"] }
          }
        }
      ]
    },
    {
      "name": "6. BƯỚC 4 - Quản lý kho phê duyệt",
      "item": [
        {
          "name": "PHÊ DUYỆT - Nhập kho thành công (tạo Batch)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', function() { pm.response.to.have.status(200); });",
                  "var data = pm.response.json();",
                  "pm.test('Status chuyển sang APPROVED', function() { pm.expect(data.status).to.eql('APPROVED'); });",
                  "pm.test('Có approvedBy', function() { pm.expect(data.approvedBy).to.not.be.null; });",
                  "pm.test('Có approvedAt', function() { pm.expect(data.approvedAt).to.not.be.null; });",
                  "console.log('Approved at:', data.approvedAt, 'By:', data.approvedBy ? data.approvedBy.username : 'N/A');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"approved\": true,\n  \"notes\": \"Đã kiểm tra thông tin nhập kho. Số lượng và chất lượng hàng đạt yêu cầu. Phê duyệt nhập kho.\"\n}"
            },
