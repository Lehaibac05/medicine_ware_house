# ==================================================
# AI Model Service Configuration
# ==================================================

# Address của AI Model Server
AI_SERVICE_URL=http://localhost:5000

# Timeout cho API calls (milliseconds)
AI_SERVICE_TIMEOUT=30000

# ==================================================
# Flask Server Configuration
# ==================================================

# Flask host & port
FLASK_HOST=0.0.0.0
FLASK_PORT=5000

# Environment (development, production)
FLASK_ENV=development

# ==================================================
# Data Paths
# ==================================================

# Đường dẫn tới file dữ liệu training
DATA_PATH=../data/pharmacy_training_final.csv

# Đường dẫn lưu model
MODEL_PATH=models/demand_hybrid_model.pkl

# ==================================================
# Model Configuration
# ==================================================

# Random Forest parameters
RF_N_ESTIMATORS=200
RF_MAX_DEPTH=15

# XGBoost parameters
XGB_N_ESTIMATORS=200
XGB_LEARNING_RATE=0.05
XGB_MAX_DEPTH=8

# Training episodes for RL Agent
RL_EPISODES=1000

